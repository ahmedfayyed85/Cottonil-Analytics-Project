table Fact_SupplierAccount
	lineageTag: a5f5a9a2-22be-4732-a9d5-0907d9d21407

	measure 'Total Supplier Invoices' =
			
			SUM(Fact_SupplierAccount[Invoices])
		lineageTag: ec19156d-f182-44a3-95ac-c31f62c3257c

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Supplier Payments' =
			
			SUM(Fact_SupplierAccount[Payments])
		formatString: 0
		lineageTag: acdc5fde-fa26-4f10-ace7-c546e23e6d76

	measure 'Total Supplier Returns Value' =
			
			SUM(Fact_SupplierAccount[Returns])
		lineageTag: dd52936f-f605-4e2e-ae65-861a5f8450af

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Total Purchase Quantity2' =
			
			SUM(Fact_SupplierProducts[Purchase_Quantity])
		formatString: 0
		lineageTag: 98b17453-5a7a-4f6b-9b87-67ed08a67e90

	measure 'Latest Supplier Balance' =
			
			VAR CurrentSupplier =
			    SELECTEDVALUE(Dim_Supplier[Supplier])
			
			VAR LastTransaction =
			    TOPN(
			        1,
			        FILTER(
			            ALL(Fact_SupplierAccount),
			            Fact_SupplierAccount[Supplier] = CurrentSupplier
			        ),
			        Fact_SupplierAccount[Transaction_Date], DESC,
			        Fact_SupplierAccount[Transaction_Index], DESC
			    )
			
			RETURN
			    MAXX(
			        LastTransaction,
			        Fact_SupplierAccount[Balance]
			    )
		lineageTag: 15110029-e66d-42c8-8bd7-5e15aab8b0b7

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Latest Balance Type' =
			
			VAR CurrentSupplier =
			    SELECTEDVALUE(Dim_Supplier[Supplier])
			
			VAR LastTransaction =
			    TOPN(
			        1,
			        FILTER(
			            ALL(Fact_SupplierAccount),
			            Fact_SupplierAccount[Supplier] = CurrentSupplier
			        ),
			        Fact_SupplierAccount[Transaction_Date], DESC,
			        Fact_SupplierAccount[Transaction_Index], DESC
			    )
			
			RETURN
			    MAXX(
			        LastTransaction,
			        Fact_SupplierAccount[Balance_Type]
			    )
		lineageTag: c2ccf13d-5b82-41de-a026-3de21932802a

	measure 'Total Latest Supplier Balance' =
			
			SUMX(
			    VALUES(Dim_Supplier[Supplier]),
			    [Latest Supplier Balance]
			)
		lineageTag: 187e2b6f-21e6-4acf-ab16-67f928549909

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Supplier Outstanding Balance' =
			
			SUMX(
			    FILTER(
			        VALUES(Dim_Supplier[Supplier]),
			        [Latest Balance Type] = "دائن"
			    ),
			    [Latest Supplier Balance]
			)
		lineageTag: b47d68ae-c3a0-4c8a-b1e8-e2c7a73c7fa0

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Supplier Return Rate' =
			
			DIVIDE(
			    [Total Supplier Returns Value],
			    [Total Supplier Invoices],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: db3e8a38-cbf7-417c-b302-56c7da3c994c

