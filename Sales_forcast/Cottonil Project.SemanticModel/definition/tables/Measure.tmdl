			        "—",
			        FORMAT ( StockValue, "#,##0" )
			    )
			
			RETURN
			    "
			    <div class='stock-card'>
			        <div class='card-title'>Current Stock</div>
			        <div class='card-value'>" & DisplayValue & "</div>
			    </div>
			
			    <style>
			    .stock-card {
			        width: 270px;
			        height: 196px;
			        box-sizing: border-box;
			        background: #FFFFFF;
			        border-radius: 18px;
