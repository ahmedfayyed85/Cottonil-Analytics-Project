table Fact_NetSales
	lineageTag: 3ab62ce2-437d-41ed-88f3-83dae3988f4b

	measure 'Net Sales Records' =
			
			COUNTROWS(Fact_NetSales)
		formatString: 0
		lineageTag: ecad6b1f-9229-4deb-adee-a822464743f5

	measure 'Total Discount Value' =
			
			SUMX(
			    Fact_NetSales,
			    Fact_NetSales[Discount] *
			    Fact_NetSales[Quantity]
			)
		lineageTag: fb7f9dbf-bcfc-4b7f-9ea7-fea0bfc11c25

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Gross Sales Before Discount' =
			
			SUMX(
			    Fact_NetSales,
			    Fact_NetSales[Price] *
			    Fact_NetSales[Quantity]
			)
		lineageTag: 70e157c1-079b-48ba-af94-a53249124fe3

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales After Discount' =
			
			SUM(Fact_NetSales[Total_Value])
		lineageTag: 32843d63-1d5c-471b-a754-2b70857a90f9

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Overall Discount Rate %' =
			
			DIVIDE(
			    [Total Discount Value],
			    [Gross Sales Before Discount],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: db682306-6667-4b6c-93e2-495031816614

	measure 'Discount Reconciliation Difference' =
			
			[Gross Sales Before Discount]
			    - [Total Discount Value]
			    - [Net Sales After Discount]
		lineageTag: d3de0051-01d3-44fb-8c37-6d5729f55008

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Product Discount Rate %' =
			
			DIVIDE(
			    [Total Discount Value],
			    [Gross Sales Before Discount],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 862f9b6d-73cf-448a-82db-fd575185b06a

	measure 'Department Discount Rate %' =
			
			DIVIDE(
			    [Total Discount Value],
			    [Gross Sales Before Discount],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: db0af355-4dfb-41a6-a593-51082a1df0aa

	measure 'Total Net Sales Quantity' =
			
			SUM(Fact_NetSales[Quantity])
		formatString: 0
		lineageTag: a4851d8b-596a-487d-9639-1870920d2eec

	measure 'Discounted Sales Quantity' =
			
			CALCULATE(
			    SUM(Fact_NetSales[Quantity]),
			    Fact_NetSales[Discount] > 0
			)
		formatString: 0
		lineageTag: 4c2dfbba-e19c-4b30-a726-d26f04098861

	measure 'Discount Rate by Product Group %' =
			
			DIVIDE(
			    [Total Discount Value],
			    [Gross Sales Before Discount],
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: bfa7809d-3ec5-4e95-8fa2-a43dc0aac1ef

