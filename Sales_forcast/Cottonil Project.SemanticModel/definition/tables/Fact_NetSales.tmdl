		dataType: double
		lineageTag: 519779d3-db84-444e-94de-1b8a0838c752
		summarizeBy: sum
		sourceColumn: Net_Price

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Total_Value
		dataType: double
		lineageTag: ee5c71fb-3f9e-437b-9daf-72ea38e992ac
		summarizeBy: sum
		sourceColumn: Total_Value

		annotation SummarizationSetBy = Automatic

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	column Size
		dataType: string
		lineageTag: 8c46e7f8-9adf-465d-9132-c5ad635fe418
		summarizeBy: none
		sourceColumn: Size

		annotation SummarizationSetBy = Automatic

	column Color
		dataType: string
		lineageTag: 66957218-b125-434c-999f-4958c4ef51eb
		summarizeBy: none
		sourceColumn: Color

		annotation SummarizationSetBy = Automatic

	column 'Discount Level' =
			
			VAR Rate =
			    DIVIDE(
			        Fact_NetSales[Discount],
			        Fact_NetSales[Price],
			        0
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        Rate = 0, "No Discount",
			        Rate <= 0.05, "0–5%",
			        Rate <= 0.10, "5–10%",
			        Rate <= 0.20, "10–20%",
			        "Above 20%"
			    )
		lineageTag: fd6ef9bf-29f3-4a21-9701-c3b3cfd11c3e
		summarizeBy: none
		sortByColumn: 'Discount Level Sort'

		changedProperty = SortByColumn

		annotation SummarizationSetBy = Automatic

	column 'Discount Level Sort' =
			
			VAR Rate =
			    DIVIDE(
			        Fact_NetSales[Discount],
			        Fact_NetSales[Price],
			        0
			    )
			RETURN
			    SWITCH(
			        TRUE(),
			        Rate = 0, 1,
			        Rate <= 0.05, 2,
			        Rate <= 0.10, 3,
			        Rate <= 0.20, 4,
			        5
			    )
		formatString: 0
		lineageTag: a67c4944-2de2-4aaf-bc26-e7884c07be0d
		summarizeBy: sum

		annotation SummarizationSetBy = Automatic

	column 'Discount Status' =
			
			IF(
			    Fact_NetSales[Discount] > 0,
			    "Discounted",
			    "No Discount"
			)
		lineageTag: 3c4f8b00-917c-4127-8a52-b5da2d2b4fd1
		summarizeBy: none

		annotation SummarizationSetBy = Automatic

