table Fact_SupplierProducts
	lineageTag: 030c31fa-d6ac-4375-8b86-9f346ff455c5

	measure 'Total Purchase Returns' =
			
			SUM(Fact_SupplierProducts[Purchase_Return_Quantity])
		formatString: 0
		lineageTag: 59e75ae7-36a0-4fff-b7b1-322f7009c1cc

	measure 'Purchase Return Rate' =
			
			DIVIDE(
			    [Total Purchase Returns],
			    SUM(Fact_SupplierProducts[Purchase_Quantity]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 0a62ceec-02cc-42a4-8245-f45c294d5439

	measure 'Returned Products' =
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_SupplierProducts[Product_Code]),
			    Fact_SupplierProducts[Purchase_Return_Quantity] > 0
			)
		formatString: 0
		lineageTag: 50d5996b-79df-4220-bb67-4c517ca44318

	measure 'Total Sales Returns' =
			
			SUM(Fact_SupplierProducts[Sales_Return_Quantity])
		formatString: 0
		lineageTag: 6634dca9-1873-455a-aff1-6404f8efde23

	measure 'Sales Return Rate' =
			
			DIVIDE(
			    [Total Sales Returns],
			    SUM(Fact_SupplierProducts[Sales_Quantity]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 9b6d3b26-f1ef-45ce-a762-0eb71c9237b4

	measure 'Products with Sales Returns' =
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_SupplierProducts[Product_Code]),
			    Fact_SupplierProducts[Sales_Return_Quantity] > 0
			)
		formatString: 0
		lineageTag: 10298a89-aac5-4f16-9cbd-42ce39ae98f8

	measure 'Purchase Return Rate2' =
			
			DIVIDE(
			    SUM(Fact_SupplierProducts[Purchase_Return_Quantity]),
			    SUM(Fact_SupplierProducts[Purchase_Quantity]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 638817cd-3319-4b0e-84fe-2ba57def4359

	measure 'Sales Return Rate2' =
			
			DIVIDE(
			    SUM(Fact_SupplierProducts[Sales_Return_Quantity]),
			    SUM(Fact_SupplierProducts[Sales_Quantity]),
			    0
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: f5096426-9321-4980-a110-c9300c314c70

	measure 'Purchase Return Rate (100+ Units)' =
			
			IF(
			    SUM(Fact_SupplierProducts[Purchase_Quantity]) >= 100,
			    [Purchase Return Rate],
			    BLANK()
			)
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 59c78da7-d9c5-4a3f-8c35-da2d47632cd3

