table Fact_Sales
	lineageTag: 4ccc8273-266d-4f7e-92ed-afd3fc5cc1da

	measure 'Total Sales Revenue' =
			
			SUM(Fact_Sales[Total_Value])
		formatString: #,0.00
		lineageTag: 61f1aa99-9f25-4b6e-9630-937a0e5a2fc2

		changedProperty = IsHidden

	measure 'Total Invoices' =
			
			CALCULATE(
			    DISTINCTCOUNT(Fact_Sales[Permission_Number]),
			    Fact_Sales[Permission_Number] <> BLANK(),
			    Fact_Sales[Date] <> BLANK()
			)
		formatString: 0
		lineageTag: 775576e4-410e-401f-8020-59d5df12dcfb

		changedProperty = IsHidden

	measure 'Average Transaction Value' =
			
			DIVIDE(
			    [Total Sales Revenue],
			    [Total Invoices],
			    0
			)
		formatString: 0.00
		lineageTag: b192f365-5626-428a-955c-a8dcc0abe94b

		changedProperty = IsHidden

	measure 'Average Items per Invoice' =
			
			DIVIDE(
			    SUM(Fact_Sales[Quantity]),
			    [Total Invoices],
			    0
			)
		formatString: 0.00
		lineageTag: 97943364-872e-42ab-b434-f40f64d95e3e

		changedProperty = IsHidden

	measure 'Total Sales Quantity2' =
			
			SUM(Fact_Sales[Quantity])
		formatString: 0
		lineageTag: 8ef28bad-8c1e-4152-81dc-c428a58438de

		changedProperty = IsHidden

	measure 'Product Sales Contribution %' =
			
			VAR ProductSales =
			    [Total Sales Revenue]
			
			VAR TotalSalesAllProducts =
			    CALCULATE(
			        [Total Sales Revenue],
			        REMOVEFILTERS(Dim_Product_Final)
			    )
			
			RETURN
			    DIVIDE(
			        ProductSales,
			        TotalSalesAllProducts,
			        0
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: a654f6dc-5f4f-45e8-8f6d-c695d24937ec

		changedProperty = IsHidden

	measure 'Average Selling Price' =
			
			DIVIDE(
			    SUM(Fact_Sales[Total_Value]),
			    SUM(Fact_Sales[Quantity]),
			    0
			)
		lineageTag: 85521944-3d76-4f9e-83df-1bce9a6f8bd9

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Month Sales' =
			
			CALCULATE(
			    [Total Sales Revenue],
			    DATEADD(Dim_Date[Date], -1, MONTH)
			)
		lineageTag: 0498aed0-bd53-43ba-b70e-ff9e65780b03

		changedProperty = IsHidden

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Sales MoM Growth %' =
			
			VAR CurrentSales =
			    [Total Sales Revenue]
			
			VAR PreviousSales =
			    [Previous Month Sales]
			
			RETURN
			    IF(
			        ISBLANK(CurrentSales)
			            || ISBLANK(PreviousSales)
			            || PreviousSales = 0,
			        BLANK(),
			        DIVIDE(
			            CurrentSales - PreviousSales,
			            PreviousSales
			        )
			    )
		formatString: 0.00%;-0.00%;0.00%
		lineageTag: 12a671e6-db18-4853-bea0-9dba3f842247

		changedProperty = IsHidden

