	measure 'HTML - Sales Performance Total Sales Revenue Card' =
			
						VAR KpiValue = [Total Sales Revenue]
						VAR DisplayValue =
						    SWITCH (
						        TRUE (),
			                ISBLANK ( KpiValue ), "—",
			                ABS ( KpiValue ) >= 1000000, FORMAT ( KpiValue / 1000000, "0.00" ) & "M",
			                ABS ( KpiValue ) >= 1000, FORMAT ( KpiValue / 1000, "0.00" ) & "K",
			                FORMAT ( KpiValue, "0.00" )
						    )
						VAR MoMValue = [Selected Month Sales Revenue MoM %]
						VAR MoMText =
						    IF (
						        ISBLANK ( MoMValue ),
						        "Select one month for MoM",
						        "MoM " & FORMAT ( MoMValue, "+0.0%;-0.0%;0.0%" )
						    )
						VAR MoMColor = IF ( MoMValue < 0, "#B42318", "#85831A" )
						RETURN
						    "
						    <div class='sales-card'>
						        <div class='card-title'>Total Sales Revenue</div>
						        <div class='card-value'>" & DisplayValue & "</div>
						        <div class='card-mom' style='color:" & MoMColor & ";'>" & MoMText & "</div>
						    </div>
						    <style>
						    .sales-card {
						        width: 270px;
						        height: 196px;
						        box-sizing: border-box;
						        background: #FBF4E2;
						        border-radius: 18px;
						        padding: 14px;
						        display: flex;
						        flex-direction: column;
						        align-items: center;
						        font-family: Segoe UI, sans-serif;
						        transition: background 0.3s ease;
						        cursor: pointer;
						        position: relative;
						    }
						    .sales-card .card-title {
						        color: #000000;
						        font-size: 25px;
						        font-weight: 500;
						        margin: 0;
						        text-align: center;
						    }
						    .sales-card .card-value {
						        color: #000000;
						        font-size: 23px;
						        font-weight: 600;
						        position: absolute;
						        top: 50%;
						        left: 50%;
						        transform: translate(-50%, -50%);
						    }
						    .sales-card .card-mom {
						        font-size: 13px;
						        font-weight: 600;
						        position: absolute;
						        top: 72%;
						        left: 50%;
						        transform: translateX(-50%);
						        white-space: nowrap;
						    }
						    .sales-card:hover {
						        background: #ffcb2d;
						    }
						    </style>
						    "
		lineageTag: 31a22ddb-806a-44ab-b1c8-75139936cb52

