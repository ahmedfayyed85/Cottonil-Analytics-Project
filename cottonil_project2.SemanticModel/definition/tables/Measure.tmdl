			        )
			    )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: b615c7b1-585f-4c82-8622-c4922f77375c

	measure 'Selected Month Average Items per Invoice MoM %' =
			
			VAR SelectedMonthText = SELECTEDVALUE ( Dim_Date[Year Month] )
			VAR SelectedMonthStart =
			    IF (
			        NOT ISBLANK ( SelectedMonthText ),
			        DATE ( VALUE ( LEFT ( SelectedMonthText, 4 ) ), VALUE ( RIGHT ( SelectedMonthText, 2 ) ), 1 )
			    )
			VAR PreviousMonthStart = EOMONTH ( SelectedMonthStart, -2 ) + 1
			VAR PreviousMonthEnd = SelectedMonthStart - 1
			VAR CurrentMonthEnd = EOMONTH ( SelectedMonthStart, 0 )
			VAR CurrentValue =
			    IF (
			        ISBLANK ( SelectedMonthText ),
			        BLANK (),
			        CALCULATE (
			            [Average Items per Invoice],
			            REMOVEFILTERS ( Dim_Date ),
			            DATESBETWEEN ( Dim_Date[Date], SelectedMonthStart, CurrentMonthEnd )
			        )
			    )
			VAR PreviousValue =
			    IF (
			        ISBLANK ( SelectedMonthText ),
			        BLANK (),
			        CALCULATE (
			            [Average Items per Invoice],
			            REMOVEFILTERS ( Dim_Date ),
			            DATESBETWEEN ( Dim_Date[Date], PreviousMonthStart, PreviousMonthEnd )
			        )
			    )
			RETURN
			    IF (
			        ISBLANK ( SelectedMonthText ),
			        BLANK (),
			        IF (
			            ISBLANK ( PreviousValue ) || PreviousValue = 0,
			            0,
			            DIVIDE ( COALESCE ( CurrentValue, 0 ) - PreviousValue, PreviousValue, 0 )
			        )
			    )
		formatString: +0.0%;-0.0%;0.0%
		lineageTag: dcc7642b-ec31-42fc-b69f-238144e3e9ed

