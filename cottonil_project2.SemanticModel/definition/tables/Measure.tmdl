			    IF (
			        ISBLANK ( SelectedMonthText ),
			        BLANK (),
			        CALCULATE (
			            [Total Invoices],
			            REMOVEFILTERS ( Dim_Date ),
			            DATESBETWEEN ( Dim_Date[Date], PreviousMonthStart, PreviousMonthEnd )
			        )
			    )
			RETURN
			    IF (
			        ISBLANK ( SelectedMonthText ),
			        BLANK (),
			        IF (
