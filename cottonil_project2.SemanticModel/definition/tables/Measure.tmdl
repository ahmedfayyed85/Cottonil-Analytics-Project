table Measure
	lineageTag: 1da4822d-61d5-43e8-8c14-cefa99e5240e

	measure 'HTML - Total Sales Card' =
			
			VAR SalesValue =
			    [Total Sales Value]
			
			VAR MoMValue =
			    [Sales MoM Growth %]
			
			VAR DisplayValue =
			    SWITCH (
			        TRUE (),
			        ISBLANK ( SalesValue ), "—",
			        ABS ( SalesValue ) >= 1000000,
			            FORMAT ( SalesValue / 1000000, "0.0" ) & "M",
			        ABS ( SalesValue ) >= 1000,
			            FORMAT ( SalesValue / 1000, "0.0" ) & "K",
			        FORMAT ( SalesValue, "#,##0" )
			    )
			
			VAR MoMText =
			    IF (
			        ISBLANK ( MoMValue ),
			        "Select one month for MoM",
			        "MoM " & FORMAT ( MoMValue, "+0.0%;-0.0%;0.0%" )
			    )
			
			VAR MoMColor =
			    IF ( MoMValue < 0, "#B42318", "#85831A" )
			
			RETURN
			    "
			    <div class='sales-card'>
			        <div class='card-title'>Total Sales</div>
			        <div class='card-value'>" & DisplayValue & "</div>
			        <div class='card-mom' style='color:" & MoMColor & ";'>" & MoMText & "</div>
			    </div>
			
			    <style>
			    .sales-card {
			        width: 270px;
			        height: 196px;
			        box-sizing: border-box;
			        background: #FBF4E2;
			        border-radius: 18px;
			        padding: 14px;
			        display: flex;
			        flex-direction: column;
			        align-items: center;
			        font-family: Segoe UI, sans-serif;
			        transition: background 0.3s ease;
			        cursor: pointer;
			        position: relative;
			    }
			
			    .sales-card .card-title {
			        color: #000000;
			        font-size: 25px;
			        font-weight: 500;
			        margin: 0;
			        text-align: center;
			    }
			
			    .sales-card .card-value {
			        color: #000000;
			        font-size: 23px;
			        font-weight: 600;
			        position: absolute;
			        top: 50%;
			        left: 50%;
			        transform: translate(-50%, -50%);
			    }
			
			    .sales-card .card-mom {
			        font-size: 13px;
			        font-weight: 600;
			        position: absolute;
			        top: 72%;
			        left: 50%;
			        transform: translateX(-50%);
			        white-space: nowrap;
			    }
			
			    .sales-card:hover {
			        background: #ffcb2d;
			    }
			    </style>
			    "
		lineageTag: 245af9ee-b98e-4173-a4db-876095745275

