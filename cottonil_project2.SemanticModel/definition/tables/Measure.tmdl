	measure 'Supplier Returns Value MoM %' =
			VAR SelectedYearMonth = SELECTEDVALUE ( Dim_Date[Year Month] )
			VAR CurrentMonthStart = IF ( NOT ISBLANK ( SelectedYearMonth ), DATE ( VALUE ( LEFT ( SelectedYearMonth, 4 ) ), VALUE ( RIGHT ( SelectedYearMonth, 2 ) ), 1 ) )
			VAR PreviousMonthStart = EOMONTH ( CurrentMonthStart, -2 ) + 1
			VAR PreviousMonthEnd = EOMONTH ( CurrentMonthStart, -1 )
			VAR CurrentValue = [Total Supplier Returns Value]
			VAR PreviousValue = CALCULATE ( [Total Supplier Returns Value], REMOVEFILTERS ( Dim_Date ), DATESBETWEEN ( Dim_Date[Date], PreviousMonthStart, PreviousMonthEnd ) )
			RETURN IF ( ISBLANK ( CurrentMonthStart ) || ISBLANK ( CurrentValue ) || ISBLANK ( PreviousValue ) || PreviousValue = 0, BLANK (), DIVIDE ( CurrentValue - PreviousValue, PreviousValue ) )
		formatString: 0.0%;-0.0%;0.0%
		lineageTag: bed7f1e5-a726-40a0-bfba-f48f5b2a83a9

	measure 'Supplier Payments MoM %' =
