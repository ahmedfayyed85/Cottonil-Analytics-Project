		lineageTag: 7593ab1d-5b2f-49ba-94f0-bcc1a427371d

	measure 'Total Net Sales (Date Aware)' =
			
			VAR VisibleInvoices =
			    VALUES ( Fact_Sales[Permission_Number] )
			RETURN
			    CALCULATE (
			        SUM ( Fact_NetSales[Net_Price] ),
			        TREATAS (
			            VisibleInvoices,
			            Fact_NetSales[Permission_Number]
			        )
			    )
		lineageTag: 02fdc03f-7910-417c-a41e-6d45b49f300d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Month Net Sales' =
			
			CALCULATE (
			    [Total Net Sales (Date Aware)],
			    DATEADD ( Dim_Date[Date], -1, MONTH )
			)
		lineageTag: 84a75594-2a98-4a06-90b2-022d32f6c87d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Net Sales MoM %' =
			
			VAR CurrentSales = [Total Net Sales (Date Aware)]
			VAR PreviousSales = [Previous Month Net Sales]
			RETURN
			    IF (
			        NOT HASONEVALUE ( Dim_Date[Year Month] )
			            || ISBLANK ( CurrentSales )
			            || ISBLANK ( PreviousSales )
			            || PreviousSales = 0,
			        BLANK (),
			        DIVIDE ( CurrentSales - PreviousSales, PreviousSales )
			    )
		lineageTag: 659f6d89-e517-44d5-bd7d-5e69418c5b0d

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure 'Previous Month Purchase Value' =
			
